# ============================================================================
# Bin Suleman CRM — environment variable NAMES only.
#
#   Copy this file to `.env.local` and fill in real values THERE.
#   `.env.local` is git-ignored. NEVER commit, paste into chat, or share
#   the real values of any 🔒 (secret) variable below.
#   This file must never contain real values.
# ============================================================================

# --- Supabase (CRM project — NOT the website project) -----------------------
# 🌐 public by design (RLS protects the data), but still per-project:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 🔒 SERVER-ONLY. Used by webhook/team API routes. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta Facebook Lead Ads (Phase 2 — placeholders until the Meta app exists)
# 🔒 App secret used to verify X-Hub-Signature-256 on webhook requests.
META_APP_SECRET=
# 🔒 Random string you invent; Meta echoes it during webhook GET verification.
META_VERIFY_TOKEN=
# 🔒 Long-lived Page access token with leads_retrieval permission.
META_PAGE_ACCESS_TOKEN=

# --- Google Sheets (Phase 3 — placeholders until the service account exists)
# 🔒 Entire Google service-account JSON key pasted as a single value.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- App protection ---------------------------------------------------------
# 🔒 Random string; Vercel sends it as `Authorization: Bearer <CRON_SECRET>`
#    to cron-protected routes (e.g. /api/cron/drain). Generate with a
#    password manager; any long random string works.
CRON_SECRET=
